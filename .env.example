# Copy this file to .env and replace every placeholder. Never commit .env.
BUILDBOOK_PROFILE_PATH=C:\\Buildbook\\data\\profile.json
BUILDBOOK_PROFILE_LOCK_PATH=C:\\Buildbook\\data\\profile.lock
BUILDBOOK_LOCAL_API_HOST=127.0.0.1
BUILDBOOK_LOCAL_API_PORT=43127
BUILDBOOK_LOCAL_API_TOKEN=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS

# Keep false until the browser UI is connected to this same profile store.
BUILDBOOK_TELEGRAM_ENABLED=false
BUILDBOOK_TELEGRAM_BOT_TOKEN=REPLACE_WITH_BOTFATHER_TOKEN
BUILDBOOK_TELEGRAM_ALLOWED_USER_IDS=REPLACE_WITH_NUMERIC_TELEGRAM_USER_ID
BUILDBOOK_TELEGRAM_INBOX_PATH=C:\\Buildbook\\data\\telegram-inbox.json
BUILDBOOK_TELEGRAM_OFFSET_PATH=C:\\Buildbook\\data\\telegram-offset.json
BUILDBOOK_TELEGRAM_INSTANCE_LOCK_PATH=C:\\Buildbook\\data\\telegram.lock
